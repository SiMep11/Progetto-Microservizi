<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
		<add key="github" value="https://nuget.pkg.github.com/SiMep11/index.json" />
	</packageSources>
	<packageSourceCredentials>
		<github>
			<add key="Username" value="SiMep11" />
			<add key="ClearTextPassword" value="%GH_TOKEN%" />
		</github>
	</packageSourceCredentials>
	<!-- I pacchetti del progetto arrivano SOLO da GitHub Packages.
	     Senza questo blocco, se il feed GitHub non risponde NuGet ripiega su nuget.org
	     e puo' scaricare un pacchetto omonimo pubblicato da qualcun altro. -->
	<packageSourceMapping>
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
		<packageSource key="github">
			<package pattern="KafkaUtility" />
			<package pattern="Magazzino.*" />
			<package pattern="Ordini.*" />
			<package pattern="Pagamenti.*" />
		</packageSource>
	</packageSourceMapping>
</configuration>
